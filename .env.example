DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-with-a-long-random-string"

# Optional: removes Google's shared daily limit on page-speed checks (free key from Google Cloud)
PSI_API_KEY=""

# AI visibility tracking: each engine turns on when its key is set
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
PERPLEXITY_API_KEY=""

# Optional model overrides (defaults shown)
# OPENAI_MODEL="gpt-5-mini"
# ANTHROPIC_MODEL="claude-opus-5-5"
# GEMINI_MODEL="gemini-2.5-flash"
# PERPLEXITY_MODEL="sonar"

# Billing (optional): Stripe secret key, webhook signing secret, and one recurring price ID per plan
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_STARTER=""
# STRIPE_PRICE_GROWTH=""
# STRIPE_PRICE_ADVANCED=""
# STRIPE_PRICE_AGENCY_CLIENT=""   # per-client seat price for agencies (quantity = client workspaces)
# APP_URL="https://app.example.com"   # used for Stripe return links

# Encrypts stored WordPress/Shopify credentials (32 bytes, base64). Falls back to a key derived from SESSION_SECRET.
# ENCRYPTION_KEY=""

# Shopify app (optional): from your app in the Shopify Partner dashboard
# SHOPIFY_API_KEY=""
# SHOPIFY_API_SECRET=""

# Optional: model for the beta extractability judge (default claude-haiku-5-5)
# JUDGE_MODEL="claude-haiku-5-5"

# Internal account-success console at /staff (comma-separated emails)
# STAFF_EMAILS=""
