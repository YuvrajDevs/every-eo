generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  memberships  Membership[]
}

// One workspace per client business, or per agency (which later manages many client domains).
model Organization {
  id          String       @id @default(cuid())
  name        String
  kind        String       @default("standard") // standard | agency | client (a client workspace owned by an agency)
  // White-label branding (agencies); client workspaces inherit their agency's.
  brandName    String?
  brandLogoUrl String?
  brandColor   String?     // #rrggbb
  reportFooter String?
  parentId    String?      // the agency that owns this client workspace
  parent      Organization?  @relation("AgencyClients", fields: [parentId], references: [id], onDelete: Cascade)
  clients     Organization[] @relation("AgencyClients")
  plan        String       @default("trial") // see lib/plans.ts
  planStatus  String?      // Stripe subscription status, e.g. active | past_due | canceled
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  currentPeriodEnd     DateTime?
  createdAt   DateTime     @default(now())
  memberships Membership[]
  domains     Domain[]
  crawls      Crawl[]
  jobs        Job[]
  apiCalls    ApiCallLog[]
  alerts      Alert[]
  fixes       Fix[]
  apiKeys     ApiKey[]
}

model Membership {
  id        String       @id @default(cuid())
  role      String       @default("owner")
  userId    String
  orgId     String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@unique([userId, orgId])
}

model Domain {
  id             String          @id @default(cuid())
  orgId          String
  hostname       String
  brandName      String?
  category       String?  // what the business is, in a customer's words ("mail scanning service")
  // Automatic re-checks: off | weekly | monthly. Visibility checks cost money, so they are opt-in.
  auditSchedule      String    @default("off")
  visibilitySchedule String    @default("off")
  visibilityTrials   Int       @default(5)
  nextAuditAt        DateTime?
  nextVisibilityAt   DateTime?
  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  alerts         Alert[]
  entity         EntityRecord?
  wordpress      WpConnection?
  shopify        ShopifyConnection?
  facts          FactsRecord?
  gscQueries     GscQuery[]
  searchDays     SearchDay[]
  truthIssues    TruthIssue[]
  fixes          Fix[]
  crawls         Crawl[]
  prompts        Prompt[]
  visibilityRuns VisibilityRun[]
  createdAt      DateTime        @default(now())

  @@unique([orgId, hostname])
}

// A question a real customer might ask an AI assistant, tracked per domain.
model Prompt {
  id        String             @id @default(cuid())
  domainId  String
  text      String
  domain    Domain             @relation(fields: [domainId], references: [id], onDelete: Cascade)
  results   VisibilityResult[]
  createdAt DateTime           @default(now())

  @@index([domainId])
}

model VisibilityRun {
  truthIssues TruthIssue[]
  id         String             @id @default(cuid())
  orgId      String
  domainId   String
  status     String             @default("queued") // queued | running | completed | failed
  trials     Int                @default(3)
  engines    String             // comma-separated engine ids
  costMicros Int                @default(0)
  error      String?
  domain     Domain             @relation(fields: [domainId], references: [id], onDelete: Cascade)
  results    VisibilityResult[]
  createdAt  DateTime           @default(now())
  finishedAt DateTime?

  @@index([domainId, createdAt])
}

// One answer from one engine for one prompt on one trial.
model VisibilityResult {
  id         String        @id @default(cuid())
  runId      String
  promptId   String
  engine     String
  trial      Int
  mentioned  Boolean       @default(false)
  cited      Boolean       @default(false)
  citedUrls  String?       // JSON array of {url,title}
  answer     String?
  error      String?
  costMicros Int           @default(0)
  run        VisibilityRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  prompt     Prompt        @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@index([runId])
}

model Crawl {
  id          String       @id @default(cuid())
  orgId       String
  domainId    String
  status      String       @default("queued") // queued | running | completed | failed
  maxPages    Int          @default(50)
  pagesCount  Int          @default(0)
  error       String?
  performance String?      // JSON PerformanceReport for the homepage
  platform    String?      // detected site builder, see lib/platforms.ts
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domain      Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  pages       Page[]
  findings    Finding[]
  robots      RobotsReport?
  judgeRuns   JudgeRun[]
  createdAt   DateTime     @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  @@index([orgId, createdAt])
}

model Page {
  id              String   @id @default(cuid())
  crawlId         String
  url             String
  statusCode      Int?
  title           String?
  metaDescription String?
  h1Count         Int      @default(0)
  h1              String?
  canonical       String?
  metaRobots      String?
  jsonLdCount     Int      @default(0)
  jsonLdTypes     String? // comma-separated @type values
  wordCount       Int      @default(0)
  answerScore     Int?
  answerSignals   String?  // JSON AnswerSignals
  excerpt         String?  // first substantial paragraph, used to suggest meta descriptions
  headings        String?  // JSON array of H2/H3 texts, used to suggest questions to track
  crawl           Crawl    @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  fetchedAt       DateTime @default(now())

  @@unique([crawlId, url])
}

model RobotsReport {
  id          String  @id @default(cuid())
  crawlId     String  @unique
  robotsUrl   String
  httpStatus  Int?
  found       Boolean @default(false)
  sitemaps    String? // newline-separated
  botAccess   String  // JSON array of BotAccessResult
  crawl       Crawl   @relation(fields: [crawlId], references: [id], onDelete: Cascade)
}

model Finding {
  id        String   @id @default(cuid())
  crawlId   String
  layer     String   // seo | aeo | geo
  code      String
  severity  String   // high | medium | low | info
  evidence  String   // proven | plausible | speculative
  title     String
  detail    String
  url       String?
  fixability String  @default("you") // you | setting | platform
  howTo     String?  // platform-specific steps
  crawl     Crawl    @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([crawlId])
}

// Database-backed job queue; swap for BullMQ/Redis when scale needs it.
model Job {
  id         String       @id @default(cuid())
  orgId      String
  type       String
  payload    String       // JSON
  status     String       @default("queued") // queued | running | completed | failed
  attempts   Int          @default(0)
  runAt      DateTime     @default(now())
  lockedAt   DateTime?
  error      String?
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
  finishedAt DateTime?

  @@index([status, runAt])
}

// Every billable external call, per client, so tier pricing is based on real cost.
model ApiCallLog {
  id        String       @id @default(cuid())
  orgId     String
  provider  String       // e.g. openai, anthropic, gemini, perplexity, psi, crawl
  operation String
  units     Int          @default(1)
  costMicros Int         @default(0) // USD * 1,000,000
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([orgId, createdAt])
}

// Something changed for the worse between two checks of the same site.
model Alert {
  id        String       @id @default(cuid())
  orgId     String
  domainId  String
  kind      String       // visibility_drop | new_issue | bot_blocked
  title     String
  detail    String
  link      String?
  readAt    DateTime?
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  domain    Domain       @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())

  @@index([orgId, createdAt])
}

// Brand + author details used to generate Organization/Person schema, author bios and a Wikidata draft.
model EntityRecord {
  id        String   @id @default(cuid())
  domainId  String   @unique
  data      String   // JSON EntityProfile (lib/entity.ts)
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}

// Credentials for the Visibility Connector plugin on a WordPress site. The application password is encrypted (lib/secrets.ts).
model WpConnection {
  id            String    @id @default(cuid())
  domainId      String    @unique
  siteUrl       String
  username      String
  secret        String    // encrypted application password
  pluginVersion String?
  yoast         Boolean   @default(false)
  robotsFile    Boolean   @default(false)
  lastCheckedAt DateTime?
  lastError     String?
  domain        Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
}

// A change the platform made (or offered to make) on a client site, with enough detail to verify and undo it.
model Fix {
  id          String    @id @default(cuid())
  orgId       String
  domainId    String
  key         String    // stable identity of the fix, e.g. "org-home", so re-audits update rather than duplicate
  type        String    // jsonld | meta_description | robots_allow
  findingCode String
  title       String
  url         String?   // target page; null for site-wide fixes
  payload     String    // JSON sent to the plugin
  status      String    @default("applied") // applied | verified | not_visible | failed | rolled_back
  error       String?
  appliedAt   DateTime?
  verifiedAt  DateTime?
  rolledBackAt DateTime?
  domain      Domain    @relation(fields: [domainId], references: [id], onDelete: Cascade)
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([domainId, key])
}

// Stripe webhook events already processed, so a retried delivery is never applied twice.
model StripeEvent {
  id        String   @id // Stripe event id
  type      String
  createdAt DateTime @default(now())
}

// Shopify app installation for a store. The Admin API access token is encrypted (lib/secrets.ts).
model ShopifyConnection {
  id             String   @id @default(cuid())
  domainId       String   @unique
  shop           String   @unique // xyz.myshopify.com
  token          String   // encrypted offline access token
  scopes         String
  installationId String?  // AppInstallation gid, owner of the app-data metafields the theme embed reads
  domain         Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
}

// Ground truth the owner provides (prices, founding year, discontinued products, signature claims, competitors).
model FactsRecord {
  id        String   @id @default(cuid())
  domainId  String   @unique
  data      String   // JSON BrandFacts (lib/truth.ts)
  domain    Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}

// A sentence in a stored AI answer that contradicts the owner's facts or credits their claim to someone else.
model TruthIssue {
  id        String        @id @default(cuid())
  domainId  String
  runId     String
  resultId  String
  engine    String
  promptId  String
  kind      String        // price_mismatch | discontinued_as_current | wrong_founding_year | stolen_claim
  sentence  String
  detail    String
  credited  String?
  domain    Domain        @relation(fields: [domainId], references: [id], onDelete: Cascade)
  run       VisibilityRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([runId])
}

// Search Console "Queries" rows imported from a CSV export (or the API later).
model GscQuery {
  id          String   @id @default(cuid())
  domainId    String
  query       String
  clicks      Int
  impressions Int
  ctr         Float?
  position    Float?
  domain      Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)
  importedAt  DateTime @default(now())

  @@index([domainId])
}

// Daily search performance imported from Search Console or Bing Webmaster Tools exports.
// source: gsc_branded | gsc_all | bing_branded | bing_all
model SearchDay {
  id          String   @id @default(cuid())
  domainId    String
  source      String
  date        DateTime // UTC midnight
  clicks      Int
  impressions Int
  domain      Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([domainId, source, date])
}

// Optional, paid "could an AI quote an answer from this page?" check (beta). Only runs when a user starts it.
model JudgeRun {
  id            String        @id @default(cuid())
  crawlId       String
  orgId         String
  status        String        @default("queued") // queued | running | completed | failed
  model         String
  estimateMicros Int          @default(0)
  costMicros    Int           @default(0)
  error         String?
  crawl         Crawl         @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  results       JudgeResult[]
  createdAt     DateTime      @default(now())
  finishedAt    DateTime?
}

model JudgeResult {
  id          String   @id @default(cuid())
  judgeRunId  String
  url         String
  question    String
  answerable  Boolean?
  score       Int?     // 0-10
  quote       String?
  quoteFound  Boolean? // the quote really appears on the page (guards against invented quotes)
  rationale   String?
  error       String?
  costMicros  Int      @default(0)
  run         JudgeRun @relation(fields: [judgeRunId], references: [id], onDelete: Cascade)
}

// API keys are shown once; only a SHA-256 hash is stored.
model ApiKey {
  id         String       @id @default(cuid())
  orgId      String
  name       String
  prefix     String       // first characters, to recognise a key in the list
  hash       String       @unique
  lastUsedAt DateTime?
  revokedAt  DateTime?
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
}
